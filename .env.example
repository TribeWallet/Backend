# =============================================================================
# TribeWallet — variáveis de ambiente
# Copie para `.env` (`cp .env.example .env`) e ajuste os valores locais.
# O `.env` está no .gitignore; este arquivo de exemplo é o que vai versionado.
# =============================================================================

# --- Aplicação -----------------------------------------------------------
# Endereço base da API. É a mesma variável usada pelo TribeWallet.http.
TRIBEWALLET_HOST_ADDRESS=http://localhost:5049

# Onde o Kestrel escuta. Mantenha em sincronia com TRIBEWALLET_HOST_ADDRESS.
ASPNETCORE_URLS=http://localhost:5049
ASPNETCORE_ENVIRONMENT=Development

# --- Banco de dados (PostgreSQL) -----------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tribewallet
POSTGRES_USER=tribewallet
POSTGRES_PASSWORD=troque-esta-senha

# Alternativa: define a connection string inteira e ignora as POSTGRES_* acima.
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=tribewallet;Username=tribewallet;Password=...

# --- Migrations e seed ---------------------------------------------------
# Aplica as migrations pendentes automaticamente no startup.
APLICAR_MIGRATIONS_NO_STARTUP=true

# Popula o banco com os dados de exemplo quando as tabelas estão vazias.
EXECUTAR_SEED=true

# Senha em texto puro dos usuários criados pelo seeder (só ambiente de desenvolvimento).
SEED_SENHA_PADRAO=Tribe@123

# --- Servidor externo de arquivos ----------------------------------------
# Base das URLs de comprovantes, imagens e PDFs de relatório.
STORAGE_BASE_URL=http://localhost:9000/tribewallet
